@namespace Shipwreck.ViewModelUtils.Components
@inherits FormGroupBase
@using (OnBeginRender())
{
    var theme = Theme ?? FormGroupTheme.Default;
    <form id="@FormGroupId"
          class="@theme.FormGroupClass @AdditionalClass"
          @onsubmit="@(() => EnterCommand?.Execute(EnterCommandParameter))"
          @onsubmit:preventDefault>
        <label for="@DateTimePickerId"
               class="@theme.LabelClass @AdditionalLabelClass"
               title="@Description">
            @if (ChildContent != null)
            {
                @ChildContent
            }
            else
            {
                @Title
            }
        </label>
        <DateTimePicker @ref="DateTimePicker"
                        Id="@DateTimePickerId"
                        ClassName="@(Theme?.ControlClass + " " + AdditionalInputClass)"
                        IsEnabled="@(!GetIsDisabled())"
                        IsReadOnly="@IsReadOnly"
                        IsRequired="@GetIsRequired()"
                        Placeholder="@GetPlaceholder()"
                        Mode="@Mode"
                        OnFocus="@(() => OnFocusCommand?.Execute(OnFocusCommandParameter))"
                        NonNullValue="@DateTime"
                        NonNullValueChanged="@(e => { DateTimeChanged?.Invoke(e); StateHasChanged(); })"
                        Value="@NullableDateTime"
                        ValueChanged="@(e => { NullableDateTimeChanged?.Invoke(e); StateHasChanged(); })" />
    </form>
}
@code
{
    private DateTimePicker _DateTimePicker;
    private DateTimePicker DateTimePicker
    {
        get => _DateTimePicker;
        set
        {
            if (value != _DateTimePicker)
            {
                _DateTimePicker = value;
                if (value != null)
                {
#pragma warning disable BL0005
                    value.NonNullValue = _DateTime;
                    value.Value = _NullableDateTime;
#pragma warning restore BL0005
                }
            }
        }
    }



    public override ValueTask FocusAsync(bool selectAll = false)
        => _DateTimePicker.FocusAsync(selectAll);
}
