@namespace Shipwreck.ViewModelUtils.Components
<div @ref="_Popover"
     id="@Id"
     tabindex="0"
     style="border-width:0;padding:0;margin:0;background-color:transparent;position-anchor:@AnchorName;position-area:block-end;position-try-fallbacks: flip-block;"
     popover="manual">
    @if (_IsOpen)
    {
        <div class="card"
             style="max-width:400px;margin:0;white-space:wrap;max-height:75vh;overflow-x:hidden;overflow-y:scroll">
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Title))
                {
                    <h5 class="card-title">@Title</h5>
                }
                <dl class="row pt-2">
                    <CascadingValue Value="LabelColumn"
                                    IsFixed="true"
                                    Name="@PopoverRow.DefaultLabelColumnParameterName">
                        @ChildContent
                    </CascadingValue>
                </dl>
                @FooterContent
                @if (Commands != null)
                {
                    <PopoverCommandsRow DataContext="Commands" />
                }
            </div>
        </div>
    }
</div>

@code
{
    [Inject]
    public IJSRuntime JS { get; set; }

    private IJSInProcessRuntime IJS => JS as IJSInProcessRuntime;

    private string _Id;
    public string Id => _Id ??= nameof(PopoverFrame) + "--" + GetHashCode();
    private string _AnchorName;
    public string AnchorName => _AnchorName ??= "--" + Id;

    [Parameter]
    public int LabelColumn { get; set; } = 4;

    [Parameter]
    public string Title { get; set; }

    [Parameter]
    public IPopoverCommands Commands { get; set; }

    [Parameter]
    public RenderFragment ChildContent { get; set; }

    [Parameter]
    public RenderFragment FooterContent { get; set; }

    private ElementReference _Popover;
    private bool _IsOpen;

    public void OnButtonFocus()
    {
        if (!_IsOpen)
        {
            _IsOpen = true;
            IJS!.ShowPopover(_Popover);
        }
    }

    public void OnButtonBlur(ElementReference button)
    {
        Task.Delay(1).ContinueWith(_ =>
            {
                if (!IJS!.ContainsActiveElement(_Popover))
                {
                    _IsOpen = false;
                    IJS!.HidePopover(_Popover);
                }
                else
                {
                    IJS!.Focus(button, true);
                }
            });
    }
}
